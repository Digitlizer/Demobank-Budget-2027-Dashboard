MEASURE _Measures[Spark A Borrowings] =
    VAR _t =
        ADDCOLUMNS (
            FILTER ( ALL ( Dim_Period[PeriodKey], Dim_Period[SortOrder] ), NOT Dim_Period[PeriodKey] IN { "A2026S", "B2026" } ),
            "@v", CALCULATE ( [Amount], Dim_Line[LineNo] = 37 ),
            "@x", SWITCH ( Dim_Period[SortOrder], 7, 5, 9, 6, Dim_Period[SortOrder] - 1 )
        )
    VAR _n = FILTER ( _t, NOT ISBLANK ( [@v] ) )
    VAR _mn = MINX ( _n, [@v] )
    VAR _mx = MAXX ( _n, [@v] )
    VAR _r = IF ( _mx = _mn, 1, _mx - _mn )
    RETURN
        CONCATENATEX ( FILTER ( _n, [@x] <= 4 ), FORMAT ( [@x] * 20, "0" ) & "," & FORMAT ( 27 - ( [@v] - _mn ) / _r * 24, "0.0" ), " ", [@x], ASC )
MEASURE _Measures[Spark F Borrowings] =
    VAR _t =
        ADDCOLUMNS (
            FILTER ( ALL ( Dim_Period[PeriodKey], Dim_Period[SortOrder] ), NOT Dim_Period[PeriodKey] IN { "A2026S", "B2026" } ),
            "@v", CALCULATE ( [Amount], Dim_Line[LineNo] = 37 ),
            "@x", SWITCH ( Dim_Period[SortOrder], 7, 5, 9, 6, Dim_Period[SortOrder] - 1 )
        )
    VAR _n = FILTER ( _t, NOT ISBLANK ( [@v] ) )
    VAR _mn = MINX ( _n, [@v] )
    VAR _mx = MAXX ( _n, [@v] )
    VAR _r = IF ( _mx = _mn, 1, _mx - _mn )
    RETURN
        CONCATENATEX ( FILTER ( _n, [@x] >= 4 ), FORMAT ( [@x] * 20, "0" ) & "," & FORMAT ( 27 - ( [@v] - _mn ) / _r * 24, "0.0" ), " ", [@x], ASC )
MEASURE _Measures[HTML Card PBT] =
    VAR _b =
        [PBT B27]
    VAR _c =
        [PBT Cmp]
    VAR _d =
        IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), _b - _c )
    VAR _p =
        DIVIDE ( _d, ABS ( _c ) )
    VAR _col =
        [PBT Colour]
    VAR _bg =
        SWITCH ( _col, "#067647", "#E7F6EE", "#B42318", "#FDECEA", "#F1F3F7" )
    VAR _arr =
        IF ( _d > 0, "▲", IF ( _d < 0, "▼", "" ) )
    VAR _ytd =
        CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 28 )
    VAR _b26 =
        CALCULATE ( [Budget 2026], Dim_Line[LineNo] = 28 )
    VAR _p26 =
        CALCULATE ( [Projected Dec-26], Dim_Line[LineNo] = 28 )
    VAR _prog =
        IF ( _b26 > 0, DIVIDE ( _ytd, _b26 ) )
    VAR _uc =
        [Selected Unit Code]
    VAR _note =
        CALCULATE ( MAX ( Fact_Commentary[Note] ), Fact_Commentary[UnitCode] = _uc, Fact_Commentary[LineNo] = 28 )
    VAR _dN =
        CALCULATE ( [Budget 2027] - [Compare Value], Dim_Line[LineNo] = 8 )
    VAR _dO =
        CALCULATE ( [Budget 2027] - [Compare Value], Dim_Line[LineNo] = 15 )
    VAR _dA =
        -CALCULATE ( [Budget 2027] - [Compare Value], Dim_Line[LineNo] = 23 )
    VAR _dP =
        CALCULATE ( [Budget 2027] - [Compare Value], Dim_Line[LineNo] = 26 )
    VAR _mxd =
        MAX ( MAX ( ABS ( _dN ), ABS ( _dO ) ), MAX ( ABS ( _dA ), ABS ( _dP ) ) )
    VAR _drv =
        SWITCH ( TRUE (), ABS ( _dN ) = _mxd, "net interest income", ABS ( _dO ) = _mxd, "non-interest income", ABS ( _dA ) = _mxd, "admin expenses", "provisions" )
    VAR _drvV =
        SWITCH ( TRUE (), ABS ( _dN ) = _mxd, _dN, ABS ( _dO ) = _mxd, _dO, ABS ( _dA ) = _mxd, _dA, _dP )
    RETURN
        "<details class='fc'><summary><div class='in'><div class='face front' style='border-top-color:"
        & _col
        & "'><div class='kl'>Profit before Tax<span class='ki'>i</span></div><div class='kv'>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & "<span class='ku'>"
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</span></div><div class='kd'><span class='pill' style='color:"
        & _col
        & ";background:"
        & _bg
        & "'>"
        & _arr
        & " "
        & IF ( ISBLANK ( _p ), "n/a", FORMAT ( _p, "+0.0%;-0.0%;0.0%" ) )
        & "</span><span class='kc'>vs "
        & [Compare Short]
        & "</span></div><svg class='sp' viewBox='0 0 120 30' preserveAspectRatio='none'><polyline class='sa' points='"
        & [Spark A PBT]
        & "' style='stroke:"
        & _col
        & "'/><polyline class='sf' points='"
        & [Spark F PBT]
        & "' style='stroke:"
        & _col
        & "'/></svg><div class='pb'><span style='width:"
        & FORMAT ( MIN ( 1, MAX ( 0, _prog ) ) * 100, "0" )
        & "%'></span><i></i></div><div class='pg'><span>2026 YTD vs budget</span><b>"
        & IF ( ISBLANK ( _prog ), "–", FORMAT ( _prog, "0%" ) )
        & "</b></div></div><div class='face back'><div class='bt'>Profit before Tax</div><ul><li><b>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & " "
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</b>, "
        & IF ( _d >= 0, "up ", "down " )
        & IF ( ISBLANK ( _p ), "", FORMAT ( ABS ( _p ), "0.0%" ) )
        & " ("
        & IF ( ISBLANK ( _d ), "–", FORMAT ( _d, "+#,0.0;-#,0.0;0.0" ) )
        & ") vs "
        & [Compare Short]
        & ".</li><li>Main driver: <b>"
        & _drv
        & "</b> ("
        & IF ( ISBLANK ( _drvV ), "–", FORMAT ( _drvV, "+#,0.0;-#,0.0;0.0" ) )
        & ").</li><li>2026: "
        & IF ( ISBLANK ( _prog ), "–", FORMAT ( _prog, "0%" ) )
        & " done by Sep (pace 75%), lands at "
        & IF ( ISBLANK ( DIVIDE ( _p26, _b26 ) ), "–", FORMAT ( DIVIDE ( _p26, _b26 ), "0%" ) )
        & ".</li></ul>"
        & IF ( ISBLANK ( _note ), "<div class='note empty'>Notes: Commentary sheet</div>", "<div class='note'>" & _note & "</div>" )
        & "</div></div></summary></details>"
MEASURE _Measures[HTML Card Total Income] =
    VAR _b =
        [Total Income B27]
    VAR _c =
        [Total Income Cmp]
    VAR _d =
        IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), _b - _c )
    VAR _p =
        DIVIDE ( _d, ABS ( _c ) )
    VAR _col =
        [Total Income Colour]
    VAR _bg =
        SWITCH ( _col, "#067647", "#E7F6EE", "#B42318", "#FDECEA", "#F1F3F7" )
    VAR _arr =
        IF ( _d > 0, "▲", IF ( _d < 0, "▼", "" ) )
    VAR _ytd =
        CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 16 )
    VAR _b26 =
        CALCULATE ( [Budget 2026], Dim_Line[LineNo] = 16 )
    VAR _p26 =
        CALCULATE ( [Projected Dec-26], Dim_Line[LineNo] = 16 )
    VAR _prog =
        IF ( _b26 > 0, DIVIDE ( _ytd, _b26 ) )
    VAR _uc =
        [Selected Unit Code]
    VAR _note =
        CALCULATE ( MAX ( Fact_Commentary[Note] ), Fact_Commentary[UnitCode] = _uc, Fact_Commentary[LineNo] = 16 )
    RETURN
        "<details class='fc'><summary><div class='in'><div class='face front' style='border-top-color:"
        & _col
        & "'><div class='kl'>Total Income<span class='ki'>i</span></div><div class='kv'>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & "<span class='ku'>"
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</span></div><div class='kd'><span class='pill' style='color:"
        & _col
        & ";background:"
        & _bg
        & "'>"
        & _arr
        & " "
        & IF ( ISBLANK ( _p ), "n/a", FORMAT ( _p, "+0.0%;-0.0%;0.0%" ) )
        & "</span><span class='kc'>vs "
        & [Compare Short]
        & "</span></div><svg class='sp' viewBox='0 0 120 30' preserveAspectRatio='none'><polyline class='sa' points='"
        & [Spark A Total Income]
        & "' style='stroke:"
        & _col
        & "'/><polyline class='sf' points='"
        & [Spark F Total Income]
        & "' style='stroke:"
        & _col
        & "'/></svg><div class='pb'><span style='width:"
        & FORMAT ( MIN ( 1, MAX ( 0, _prog ) ) * 100, "0" )
        & "%'></span><i></i></div><div class='pg'><span>2026 YTD vs budget</span><b>"
        & IF ( ISBLANK ( _prog ), "–", FORMAT ( _prog, "0%" ) )
        & "</b></div></div><div class='face back'><div class='bt'>Total Income</div><ul><li><b>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & " "
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</b>, "
        & IF ( _d >= 0, "up ", "down " )
        & IF ( ISBLANK ( _p ), "", FORMAT ( ABS ( _p ), "0.0%" ) )
        & " ("
        & IF ( ISBLANK ( _d ), "–", FORMAT ( _d, "+#,0.0;-#,0.0;0.0" ) )
        & ") vs "
        & [Compare Short]
        & ".</li><li>Net interest is <b>"
        & IF ( ISBLANK ( [NII Share B27] ), "–", FORMAT ( [NII Share B27], "0.0%" ) )
        & "</b> of income; non-interest "
        & IF ( ISBLANK ( [Non-II B27] - [Non-II Cmp] ), "–", FORMAT ( [Non-II B27] - [Non-II Cmp], "+#,0.0;-#,0.0;0.0" ) )
        & ".</li><li>2026: "
        & IF ( ISBLANK ( _prog ), "–", FORMAT ( _prog, "0%" ) )
        & " done by Sep (pace 75%), lands at "
        & IF ( ISBLANK ( DIVIDE ( _p26, _b26 ) ), "–", FORMAT ( DIVIDE ( _p26, _b26 ), "0%" ) )
        & ".</li></ul>"
        & IF ( ISBLANK ( _note ), "<div class='note empty'>Notes: Commentary sheet</div>", "<div class='note'>" & _note & "</div>" )
        & "</div></div></summary></details>"
