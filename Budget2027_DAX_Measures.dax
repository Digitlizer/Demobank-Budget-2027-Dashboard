        & ", cost of funds "
        & IF ( ISBLANK ( CALCULATE ( [Budget 2027] - [Compare Value], Dim_Line[LineNo] = 7 ) ), "–", FORMAT ( CALCULATE ( [Budget 2027] - [Compare Value], Dim_Line[LineNo] = 7 ), "+#,0.0;-#,0.0;0.0" ) )
        & ".</li><li>2026: "
