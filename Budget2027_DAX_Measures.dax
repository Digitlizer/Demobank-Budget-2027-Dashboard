MEASURE _Measures[Seg PBT B27 L1] =
    IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) = 1, [Seg PBT B27] )
MEASURE _Measures[Seg PBT Cmp L1] =
    IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) = 1, [Seg PBT Cmp] )
MEASURE _Measures[Seg Bar Colour] =
    VAR _sel = [Selected Unit Code]
    VAR _me = SELECTEDVALUE ( Dim_Unit[UnitCode] )
    RETURN IF ( _sel = "BANK" || _sel = _me, "#2457A6", "#A3ABB8" )
MEASURE _Measures[Seg Share of Bank PBT] =
    IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1, DIVIDE ( [Seg PBT B27], CALCULATE ( [Seg PBT B27], Dim_Unit[UnitCode] = "BANK" ) ) )
MEASURE _Measures[Seg Cost to Income] =
    IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1, DIVIDE ( [Seg Admin B27], [Seg Income B27] ) )
MEASURE _Measures[Seg Landing %] =
    VAR _b = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2026" )
    VAR _p = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "P2026" )
    RETURN IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1 && _b > 0, DIVIDE ( _p, _b ) )
MEASURE _Measures[Seg Landing Colour] =
    VAR _r = [Seg Landing %]
    RETURN SWITCH ( TRUE (), _r >= 0.995, "#2457A6", _r >= 0.9, "#38B2C8", "#B42318" )
MEASURE _Measures[PLS Actual Dec-25] =
    IF ( SELECTEDVALUE ( Dim_Line[LineNo] ) IN { 8, 15, 16, 23, 24, 26, 28, 30 }, [Actual Dec-25] )
MEASURE _Measures[PLS Projected Dec-26] =
    IF ( SELECTEDVALUE ( Dim_Line[LineNo] ) IN { 8, 15, 16, 23, 24, 26, 28, 30 }, [Projected Dec-26] )
MEASURE _Measures[PLS Budget 2027] =
    IF ( SELECTEDVALUE ( Dim_Line[LineNo] ) IN { 8, 15, 16, 23, 24, 26, 28, 30 }, [Budget 2027] )
MEASURE _Measures[PLS Var %] =
    IF ( SELECTEDVALUE ( Dim_Line[LineNo] ) IN { 8, 15, 16, 23, 24, 26, 28, 30 }, [Variance %] )
MEASURE _Measures[Portfolio Amount] =
    VAR _u = [Selected Unit Code]
    RETURN CALCULATE ( DIVIDE ( SUM ( Fact_Portfolio[Amount_PKR_Mn] ), [Divisor] ), Fact_Portfolio[UnitCode] = _u )
MEASURE _Measures[Portfolio B27] =
    CALCULATE ( [Portfolio Amount], Fact_Portfolio[PeriodKey] = "B2027" )
MEASURE _Measures[Portfolio Cmp] =
    VAR _k = [Compare Key]
    RETURN CALCULATE ( [Portfolio Amount], Fact_Portfolio[PeriodKey] = _k )
MEASURE _Measures[Current Deposits Share B27] =
    DIVIDE (
        CALCULATE ( [Portfolio B27], Fact_Portfolio[Portfolio] = "Deposits", Fact_Portfolio[Product] = "Current", Fact_Portfolio[Metric] = "Absolute" ),
        CALCULATE ( [Portfolio B27], Fact_Portfolio[Portfolio] = "Deposits", Fact_Portfolio[Product] = "Total Deposits", Fact_Portfolio[Metric] = "Absolute" )
    )
MEASURE _Measures[Trk Line] =
    SELECTEDVALUE ( 'Tracker Line'[LineNo], 28 )
MEASURE _Measures[Trk HIB] =
    SELECTEDVALUE ( 'Tracker Line'[HigherIsBetter], 1 )
MEASURE _Measures[Trk Budget 2026] =
    VAR _n = [Trk Line]
    RETURN IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1, CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = _n, Dim_Period[PeriodKey] = "B2026" ) )
MEASURE _Measures[Trk YTD Sep-26] =
    VAR _n = [Trk Line]
    RETURN IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1, CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = _n, Dim_Period[PeriodKey] = "A2026S" ) )
MEASURE _Measures[Trk Projected Dec-26] =
    VAR _n = [Trk Line]
    RETURN IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1, CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = _n, Dim_Period[PeriodKey] = "P2026" ) )
MEASURE _Measures[Trk YTD Progress %] =
    IF ( [Trk Budget 2026] > 0, DIVIDE ( [Trk YTD Sep-26], [Trk Budget 2026] ) )
MEASURE _Measures[Trk Projected vs Budget %] =
    IF ( [Trk Budget 2026] > 0, DIVIDE ( [Trk Projected Dec-26], [Trk Budget 2026] ) )
MEASURE _Measures[Trk Q4 Needed] =
    IF ( NOT ISBLANK ( [Trk Budget 2026] ), [Trk Budget 2026] - [Trk YTD Sep-26] )
MEASURE _Measures[Trk Avg Quarter So Far] =
    DIVIDE ( [Trk YTD Sep-26], 3 )
MEASURE _Measures[Trk Status] =
    VAR _b = [Trk Budget 2026]
    VAR _p = [Trk Projected Dec-26]
    VAR _r = DIVIDE ( _p, _b )
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( _b ) || ISBLANK ( _p ), BLANK (),
            [Trk HIB] = 0, IF ( _p <= _b * 1.005, "✓ Within budget", IF ( _p <= _b * 1.05, "! Watch", "✕ Over budget" ) ),
            _b <= 0, IF ( _p >= _b, "✓ Better than budget", "✕ Worse than budget" ),
            _r >= 0.995, "✓ On track",
            _r >= 0.9, "! Watch",
            "✕ Behind"
        )
MEASURE _Measures[Trk Status Colour] =
    SWITCH ( LEFT ( [Trk Status], 1 ), "✓", "#067647", "!", "#9A6700", "✕", "#B42318", "#6B7586" )
MEASURE _Measures[Headline] =
    VAR _b = [PBT B27]
    VAR _c = [PBT Cmp]
    VAR _p = DIVIDE ( _b - _c, ABS ( _c ) )
    VAR _u = IF ( [Divisor] = 1000, " Bn", " Mn" )
    VAR _ci0 = [Cost to Income Cmp]
    VAR _ci1 = [Cost to Income B27]
    RETURN
        [Selected Unit Name] & ":  Budget 2027 Profit before Tax PKR " & FORMAT ( _b, "#,0.0" ) & _u & ", "
            & IF ( _p >= 0, "up ", "down " ) & FORMAT ( ABS ( _p ), "0.0%" ) & " vs " & [Compare Label]
            & IF ( NOT ISBLANK ( _ci1 ), ".  Cost to income " & FORMAT ( _ci0, "0.0%" ) & " to " & FORMAT ( _ci1, "0.0%" ), "" ) & "."
MEASURE _Measures[Page Subtitle] =
    [Selected Unit Name] & "  ·  Budget 2027 vs " & [Compare Label] & "  ·  " & [Unit Label]
MEASURE _Measures[Spark A PBT] =
    VAR _t =
        ADDCOLUMNS (
            FILTER ( ALL ( Dim_Period[PeriodKey], Dim_Period[SortOrder] ), NOT Dim_Period[PeriodKey] IN { "A2026S", "B2026" } ),
            "@v", CALCULATE ( [Amount], Dim_Line[LineNo] = 28 ),
            "@x", SWITCH ( Dim_Period[SortOrder], 7, 5, 9, 6, Dim_Period[SortOrder] - 1 )
        )
    VAR _n = FILTER ( _t, NOT ISBLANK ( [@v] ) )
    VAR _mn = MINX ( _n, [@v] )
    VAR _mx = MAXX ( _n, [@v] )
    VAR _r = IF ( _mx = _mn, 1, _mx - _mn )
    RETURN
        CONCATENATEX ( FILTER ( _n, [@x] <= 4 ), FORMAT ( [@x] * 20, "0" ) & "," & FORMAT ( 27 - ( [@v] - _mn ) / _r * 24, "0.0" ), " ", [@x], ASC )
MEASURE _Measures[Spark F PBT] =
    VAR _t =
        ADDCOLUMNS (
            FILTER ( ALL ( Dim_Period[PeriodKey], Dim_Period[SortOrder] ), NOT Dim_Period[PeriodKey] IN { "A2026S", "B2026" } ),
            "@v", CALCULATE ( [Amount], Dim_Line[LineNo] = 28 ),
            "@x", SWITCH ( Dim_Period[SortOrder], 7, 5, 9, 6, Dim_Period[SortOrder] - 1 )
        )
    VAR _n = FILTER ( _t, NOT ISBLANK ( [@v] ) )
    VAR _mn = MINX ( _n, [@v] )
    VAR _mx = MAXX ( _n, [@v] )
    VAR _r = IF ( _mx = _mn, 1, _mx - _mn )
    RETURN
        CONCATENATEX ( FILTER ( _n, [@x] >= 4 ), FORMAT ( [@x] * 20, "0" ) & "," & FORMAT ( 27 - ( [@v] - _mn ) / _r * 24, "0.0" ), " ", [@x], ASC )
