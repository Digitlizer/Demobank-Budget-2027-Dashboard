// Helper tables: Modeling > New table, one at a time.

Unit Selector =
SELECTCOLUMNS (
    Dim_Unit,
    "UnitCode", Dim_Unit[UnitCode],
    "Unit", Dim_Unit[ShortName],
    "UnitName", Dim_Unit[UnitName],
    "Level", Dim_Unit[Level],
    "SortOrder", Dim_Unit[SortOrder]
)

Compare Period =
DATATABLE (
    "PeriodKey", STRING, "Compare To", STRING, "Sort", INTEGER,
    {
        { "P2026", "Projected Dec-26", 1 },
        { "B2026", "Budget 2026", 2 },
        { "A2025", "Actual Dec-25", 3 }
    }
)

Scale =
DATATABLE (
    "Scale", STRING, "Divisor", INTEGER, "Sort", INTEGER,
    { { "PKR Bn", 1000, 1 }, { "PKR Mn", 1, 2 } }
)

Bridge Steps =
DATATABLE (
    "Step", STRING, "Sort", INTEGER, "LineNo", INTEGER, "Sign", INTEGER, "IsStart", INTEGER,
    {
        { "PBT compare", 1, 28, 1, 1 },
        { "NII", 2, 8, 1, 0 },
        { "Non-interest", 3, 15, 1, 0 },
        { "Admin exp", 4, 23, -1, 0 },
        { "Provisions", 5, 26, 1, 0 }
    }
)

Tracker Line =
DATATABLE (
    "Metric", STRING, "LineNo", INTEGER, "HigherIsBetter", INTEGER, "Sort", INTEGER,
    {
        { "Profit before Tax", 28, 1, 1 },
        { "Total Income", 16, 1, 2 },
        { "Net Interest Income", 8, 1, 3 },
        { "Non-Interest Income", 15, 1, 4 },
        { "Admin Expenses", 23, 0, 5 }
    }
)

Income Mix =
DATATABLE (
    "Component", STRING, "LineNo", INTEGER, "Sort", INTEGER,
    {
        { "Net interest", 8, 1 },
        { "Commission", 10, 2 },
        { "Exchange", 12, 3 },
        { "Dividend", 11, 4 },
        { "Capital gain", 14, 5 },
        { "Other income", 13, 6 }
    }
)

// Budget 2027 Dashboard: all measures for DAX query view (fallback if you build the model by hand).
// Home > Enter data > table _Measures, then paste from DEFINE and click 'Update model with changes'.

DEFINE
MEASURE _Measures[Divisor] =
    SELECTEDVALUE ( Scale[Divisor], 1000 )
MEASURE _Measures[Unit Label] =
    SELECTEDVALUE ( Scale[Scale], "PKR Bn" )
MEASURE _Measures[Compare Key] =
    SELECTEDVALUE ( 'Compare Period'[PeriodKey], "P2026" )
MEASURE _Measures[Compare Label] =
    SELECTEDVALUE ( 'Compare Period'[Compare To], "Projected Dec-26" )
MEASURE _Measures[Selected Unit Code] =
    SELECTEDVALUE ( 'Unit Selector'[UnitCode], "BANK" )
MEASURE _Measures[Selected Unit Name] =
    SELECTEDVALUE ( 'Unit Selector'[UnitName], "Bank-wide" )
MEASURE _Measures[Amount (Axis)] =
    DIVIDE ( SUM ( Fact_PL[Amount_PKR_Mn] ), [Divisor] )
MEASURE _Measures[Amount] =
    VAR _u = [Selected Unit Code]
    RETURN CALCULATE ( [Amount (Axis)], Dim_Unit[UnitCode] = _u )
MEASURE _Measures[Budget 2027] =
    CALCULATE ( [Amount], Dim_Period[PeriodKey] = "B2027" )
MEASURE _Measures[Compare Value] =
    VAR _k = [Compare Key]
    RETURN CALCULATE ( [Amount], Dim_Period[PeriodKey] = _k )
MEASURE _Measures[YTD Sep-26] =
    CALCULATE ( [Amount], Dim_Period[PeriodKey] = "A2026S" )
MEASURE _Measures[Projected Dec-26] =
    CALCULATE ( [Amount], Dim_Period[PeriodKey] = "P2026" )
MEASURE _Measures[Budget 2026] =
    CALCULATE ( [Amount], Dim_Period[PeriodKey] = "B2026" )
MEASURE _Measures[Actual Dec-25] =
    CALCULATE ( [Amount], Dim_Period[PeriodKey] = "A2025" )
MEASURE _Measures[Actual Dec-24] =
    CALCULATE ( [Amount], Dim_Period[PeriodKey] = "A2024" )
MEASURE _Measures[Variance] =
    VAR _b = [Budget 2027]
    VAR _c = [Compare Value]
    RETURN IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), _b - _c )
MEASURE _Measures[Variance %] =
    DIVIDE ( [Variance], ABS ( [Compare Value] ) )
MEASURE _Measures[Variance Direction] =
    VAR _v = [Variance]
    VAR _hib = SELECTEDVALUE ( Dim_Line[HigherIsBetter], 1 )
    RETURN IF ( ISBLANK ( _v ) || _v = 0, 0, IF ( ( _v > 0 ) = ( _hib = 1 ), 1, -1 ) )
MEASURE _Measures[Variance Colour] =
    SWITCH ( [Variance Direction], 1, "#067647", -1, "#B42318", "#6B7586" )
MEASURE _Measures[One] =
    1
MEASURE _Measures[Compare Short] =
    SWITCH ( [Compare Key], "P2026", "Proj Dec-26", "B2026", "Bud 2026", "A2025", "Act Dec-25", "compare" )
MEASURE _Measures[PBT B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 28 )
MEASURE _Measures[PBT Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 28 )
MEASURE _Measures[PBT YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 28 )
MEASURE _Measures[PBT Var %] =
    IF ( NOT ISBLANK ( [PBT B27] ) && NOT ISBLANK ( [PBT Cmp] ), DIVIDE ( [PBT B27] - [PBT Cmp], ABS ( [PBT Cmp] ) ) )
MEASURE _Measures[PBT Sub] =
    VAR _p = [PBT Var %]
    RETURN
        IF (
            ISBLANK ( [PBT Cmp] ) || ISBLANK ( [PBT B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[PBT Colour] =
    VAR _d = [PBT B27] - [PBT Cmp]
    RETURN IF ( ISBLANK ( [PBT Cmp] ) || ISBLANK ( [PBT B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Total Income B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 16 )
MEASURE _Measures[Total Income Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 16 )
MEASURE _Measures[Total Income YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 16 )
MEASURE _Measures[Total Income Var %] =
    IF ( NOT ISBLANK ( [Total Income B27] ) && NOT ISBLANK ( [Total Income Cmp] ), DIVIDE ( [Total Income B27] - [Total Income Cmp], ABS ( [Total Income Cmp] ) ) )
MEASURE _Measures[Total Income Sub] =
    VAR _p = [Total Income Var %]
    RETURN
        IF (
            ISBLANK ( [Total Income Cmp] ) || ISBLANK ( [Total Income B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Total Income Colour] =
    VAR _d = [Total Income B27] - [Total Income Cmp]
    RETURN IF ( ISBLANK ( [Total Income Cmp] ) || ISBLANK ( [Total Income B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[NII B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 8 )
MEASURE _Measures[NII Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 8 )
MEASURE _Measures[NII YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 8 )
MEASURE _Measures[NII Var %] =
    IF ( NOT ISBLANK ( [NII B27] ) && NOT ISBLANK ( [NII Cmp] ), DIVIDE ( [NII B27] - [NII Cmp], ABS ( [NII Cmp] ) ) )
MEASURE _Measures[NII Sub] =
    VAR _p = [NII Var %]
    RETURN
        IF (
            ISBLANK ( [NII Cmp] ) || ISBLANK ( [NII B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[NII Colour] =
    VAR _d = [NII B27] - [NII Cmp]
    RETURN IF ( ISBLANK ( [NII Cmp] ) || ISBLANK ( [NII B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Non-II B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 15 )
MEASURE _Measures[Non-II Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 15 )
MEASURE _Measures[Non-II YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 15 )
MEASURE _Measures[Non-II Var %] =
    IF ( NOT ISBLANK ( [Non-II B27] ) && NOT ISBLANK ( [Non-II Cmp] ), DIVIDE ( [Non-II B27] - [Non-II Cmp], ABS ( [Non-II Cmp] ) ) )
MEASURE _Measures[Non-II Sub] =
    VAR _p = [Non-II Var %]
    RETURN
        IF (
            ISBLANK ( [Non-II Cmp] ) || ISBLANK ( [Non-II B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Non-II Colour] =
    VAR _d = [Non-II B27] - [Non-II Cmp]
    RETURN IF ( ISBLANK ( [Non-II Cmp] ) || ISBLANK ( [Non-II B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Admin Exp B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 23 )
MEASURE _Measures[Admin Exp Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 23 )
MEASURE _Measures[Admin Exp YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 23 )
MEASURE _Measures[Admin Exp Var %] =
    IF ( NOT ISBLANK ( [Admin Exp B27] ) && NOT ISBLANK ( [Admin Exp Cmp] ), DIVIDE ( [Admin Exp B27] - [Admin Exp Cmp], ABS ( [Admin Exp Cmp] ) ) )
MEASURE _Measures[Admin Exp Sub] =
    VAR _p = [Admin Exp Var %]
    RETURN
        IF (
            ISBLANK ( [Admin Exp Cmp] ) || ISBLANK ( [Admin Exp B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Admin Exp Colour] =
    VAR _d = [Admin Exp B27] - [Admin Exp Cmp]
    RETURN IF ( ISBLANK ( [Admin Exp Cmp] ) || ISBLANK ( [Admin Exp B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 0 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Staff Cost B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 18 )
MEASURE _Measures[Staff Cost Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 18 )
MEASURE _Measures[Staff Cost YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 18 )
MEASURE _Measures[Staff Cost Var %] =
    IF ( NOT ISBLANK ( [Staff Cost B27] ) && NOT ISBLANK ( [Staff Cost Cmp] ), DIVIDE ( [Staff Cost B27] - [Staff Cost Cmp], ABS ( [Staff Cost Cmp] ) ) )
MEASURE _Measures[Staff Cost Sub] =
    VAR _p = [Staff Cost Var %]
    RETURN
        IF (
            ISBLANK ( [Staff Cost Cmp] ) || ISBLANK ( [Staff Cost B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Staff Cost Colour] =
    VAR _d = [Staff Cost B27] - [Staff Cost Cmp]
    RETURN IF ( ISBLANK ( [Staff Cost Cmp] ) || ISBLANK ( [Staff Cost B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 0 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Op Profit B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 24 )
MEASURE _Measures[Op Profit Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 24 )
MEASURE _Measures[Op Profit YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 24 )
MEASURE _Measures[Op Profit Var %] =
    IF ( NOT ISBLANK ( [Op Profit B27] ) && NOT ISBLANK ( [Op Profit Cmp] ), DIVIDE ( [Op Profit B27] - [Op Profit Cmp], ABS ( [Op Profit Cmp] ) ) )
MEASURE _Measures[Op Profit Sub] =
    VAR _p = [Op Profit Var %]
    RETURN
        IF (
            ISBLANK ( [Op Profit Cmp] ) || ISBLANK ( [Op Profit B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Op Profit Colour] =
    VAR _d = [Op Profit B27] - [Op Profit Cmp]
    RETURN IF ( ISBLANK ( [Op Profit Cmp] ) || ISBLANK ( [Op Profit B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[PAT B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 30 )
MEASURE _Measures[PAT Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 30 )
MEASURE _Measures[PAT YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 30 )
MEASURE _Measures[PAT Var %] =
    IF ( NOT ISBLANK ( [PAT B27] ) && NOT ISBLANK ( [PAT Cmp] ), DIVIDE ( [PAT B27] - [PAT Cmp], ABS ( [PAT Cmp] ) ) )
MEASURE _Measures[PAT Sub] =
    VAR _p = [PAT Var %]
    RETURN
        IF (
            ISBLANK ( [PAT Cmp] ) || ISBLANK ( [PAT B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[PAT Colour] =
    VAR _d = [PAT B27] - [PAT Cmp]
    RETURN IF ( ISBLANK ( [PAT Cmp] ) || ISBLANK ( [PAT B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Advances B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 31 )
MEASURE _Measures[Advances Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 31 )
MEASURE _Measures[Advances YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 31 )
MEASURE _Measures[Advances Var %] =
    IF ( NOT ISBLANK ( [Advances B27] ) && NOT ISBLANK ( [Advances Cmp] ), DIVIDE ( [Advances B27] - [Advances Cmp], ABS ( [Advances Cmp] ) ) )
MEASURE _Measures[Advances Sub] =
    VAR _p = [Advances Var %]
    RETURN
        IF (
            ISBLANK ( [Advances Cmp] ) || ISBLANK ( [Advances B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Advances Colour] =
    VAR _d = [Advances B27] - [Advances Cmp]
    RETURN IF ( ISBLANK ( [Advances Cmp] ) || ISBLANK ( [Advances B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Deposits B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 33 )
MEASURE _Measures[Deposits Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 33 )
MEASURE _Measures[Deposits YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 33 )
MEASURE _Measures[Deposits Var %] =
    IF ( NOT ISBLANK ( [Deposits B27] ) && NOT ISBLANK ( [Deposits Cmp] ), DIVIDE ( [Deposits B27] - [Deposits Cmp], ABS ( [Deposits Cmp] ) ) )
MEASURE _Measures[Deposits Sub] =
    VAR _p = [Deposits Var %]
    RETURN
        IF (
            ISBLANK ( [Deposits Cmp] ) || ISBLANK ( [Deposits B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Deposits Colour] =
    VAR _d = [Deposits B27] - [Deposits Cmp]
    RETURN IF ( ISBLANK ( [Deposits Cmp] ) || ISBLANK ( [Deposits B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Investments B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 35 )
MEASURE _Measures[Investments Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 35 )
MEASURE _Measures[Investments YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 35 )
MEASURE _Measures[Investments Var %] =
    IF ( NOT ISBLANK ( [Investments B27] ) && NOT ISBLANK ( [Investments Cmp] ), DIVIDE ( [Investments B27] - [Investments Cmp], ABS ( [Investments Cmp] ) ) )
MEASURE _Measures[Investments Sub] =
    VAR _p = [Investments Var %]
    RETURN
        IF (
            ISBLANK ( [Investments Cmp] ) || ISBLANK ( [Investments B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Investments Colour] =
    VAR _d = [Investments B27] - [Investments Cmp]
    RETURN IF ( ISBLANK ( [Investments Cmp] ) || ISBLANK ( [Investments B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[Borrowings B27] =
    CALCULATE ( [Budget 2027], Dim_Line[LineNo] = 37 )
MEASURE _Measures[Borrowings Cmp] =
    CALCULATE ( [Compare Value], Dim_Line[LineNo] = 37 )
MEASURE _Measures[Borrowings YTD] =
    CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 37 )
MEASURE _Measures[Borrowings Var %] =
    IF ( NOT ISBLANK ( [Borrowings B27] ) && NOT ISBLANK ( [Borrowings Cmp] ), DIVIDE ( [Borrowings B27] - [Borrowings Cmp], ABS ( [Borrowings Cmp] ) ) )
MEASURE _Measures[Borrowings Sub] =
    VAR _p = [Borrowings Var %]
    RETURN
        IF (
            ISBLANK ( [Borrowings Cmp] ) || ISBLANK ( [Borrowings B27] ),
            "No comparison",
            IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) & "  vs " & [Compare Label]
        )
MEASURE _Measures[Borrowings Colour] =
    VAR _d = [Borrowings B27] - [Borrowings Cmp]
    RETURN IF ( ISBLANK ( [Borrowings Cmp] ) || ISBLANK ( [Borrowings B27] ) || _d = 0, "#6B7586", IF ( ( _d > 0 ) = ( 1 = 1 ), "#067647", "#B42318" ) )
MEASURE _Measures[PBT Card Sub] =
    [PBT Sub]
MEASURE _Measures[Cost to Income B27] =
    DIVIDE ( [Admin Exp B27], [Total Income B27] )
MEASURE _Measures[Cost to Income Cmp] =
    DIVIDE ( [Admin Exp Cmp], [Total Income Cmp] )
MEASURE _Measures[Cost to Income Chg pp] =
    ( [Cost to Income B27] - [Cost to Income Cmp] ) * 100
MEASURE _Measures[NII Share B27] =
    DIVIDE ( [NII B27], [Total Income B27] )
MEASURE _Measures[NII Share Cmp] =
    DIVIDE ( [NII Cmp], [Total Income Cmp] )
MEASURE _Measures[Profit Margin B27] =
    DIVIDE ( [PBT B27], [Total Income B27] )
MEASURE _Measures[Profit Margin Cmp] =
    DIVIDE ( [PBT Cmp], [Total Income Cmp] )
MEASURE _Measures[Staff Cost Share B27] =
    DIVIDE ( [Staff Cost B27], [Admin Exp B27] )
MEASURE _Measures[Staff Cost Share Cmp] =
    DIVIDE ( [Staff Cost Cmp], [Admin Exp Cmp] )
MEASURE _Measures[ADR B27] =
    DIVIDE ( [Advances B27], [Deposits B27] )
MEASURE _Measures[ADR Cmp] =
    DIVIDE ( [Advances Cmp], [Deposits Cmp] )
MEASURE _Measures[ADR Sub] =
    IF ( ISBLANK ( [ADR B27] ), "No deposits budgeted", "was " & FORMAT ( [ADR Cmp], "0.0%" ) & " in " & [Compare Label] )
MEASURE _Measures[Bridge Impact] =
    VAR _n = SELECTEDVALUE ( 'Bridge Steps'[LineNo] )
    VAR _s = SELECTEDVALUE ( 'Bridge Steps'[Sign] )
    VAR _start = SELECTEDVALUE ( 'Bridge Steps'[IsStart] )
    VAR _b = CALCULATE ( [Budget 2027], Dim_Line[LineNo] = _n )
    VAR _c = CALCULATE ( [Compare Value], Dim_Line[LineNo] = _n )
    RETURN IF ( _start = 1, _c, _s * ( _b - _c ) )
MEASURE _Measures[Trend Total Income] =
    IF ( NOT ( SELECTEDVALUE ( Dim_Period[PeriodKey] ) IN { "A2026S", "B2026" } ), CALCULATE ( [Amount], Dim_Line[LineNo] = 16 ) )
MEASURE _Measures[Trend Admin Exp] =
    IF ( NOT ( SELECTEDVALUE ( Dim_Period[PeriodKey] ) IN { "A2026S", "B2026" } ), CALCULATE ( [Amount], Dim_Line[LineNo] = 23 ) )
MEASURE _Measures[Trend PBT] =
    IF ( NOT ( SELECTEDVALUE ( Dim_Period[PeriodKey] ) IN { "A2026S", "B2026" } ), CALCULATE ( [Amount], Dim_Line[LineNo] = 28 ) )
MEASURE _Measures[Trend Advances] =
    IF ( NOT ( SELECTEDVALUE ( Dim_Period[PeriodKey] ) IN { "A2026S", "B2026" } ), CALCULATE ( [Amount], Dim_Line[LineNo] = 31 ) )
MEASURE _Measures[Trend Deposits] =
    IF ( NOT ( SELECTEDVALUE ( Dim_Period[PeriodKey] ) IN { "A2026S", "B2026" } ), CALCULATE ( [Amount], Dim_Line[LineNo] = 33 ) )
MEASURE _Measures[Trend Colour] =
    SWITCH (
        LEFT ( SELECTEDVALUE ( Dim_Period[PeriodKey] ), 1 ),
        "A", "#2457A6",
        "P", "#8CCBAA",
        "B", "#38B2C8",
        "#A3ABB8"
    )
MEASURE _Measures[Income Mix B27] =
    VAR _n = SELECTEDVALUE ( 'Income Mix'[LineNo] )
    VAR _v = CALCULATE ( [Budget 2027], Dim_Line[LineNo] = _n )
    RETURN IF ( _v > 0, _v )
MEASURE _Measures[Deposit Mix B27] =
    VAR _v = CALCULATE ( [Portfolio B27], Fact_Portfolio[Portfolio] = "Deposits", Fact_Portfolio[Metric] = "Absolute", Dim_Product[RowType] = "Product" )
    RETURN IF ( _v > 0, _v )
MEASURE _Measures[Advances Mix B27] =
    VAR _u = [Selected Unit Code]
    VAR _hasProducts =
        NOT ISEMPTY (
            CALCULATETABLE ( Fact_Portfolio, Fact_Portfolio[UnitCode] = _u, Fact_Portfolio[Portfolio] = "Advances", Dim_Product[RowType] = "Product", REMOVEFILTERS ( Dim_Product ) )
        )
    VAR _rt = SELECTEDVALUE ( Dim_Product[RowType] )
    VAR _keep =
        IF ( _u = "BANK", _rt IN { "Group Total", "Adjustment" }, IF ( _hasProducts, _rt = "Product", _rt = "Group Total" ) )
    RETURN
        IF ( _keep, CALCULATE ( [Portfolio B27], Fact_Portfolio[Portfolio] = "Advances", Fact_Portfolio[Metric] = "Absolute" ) )
MEASURE _Measures[Advances Mix Cmp] =
    IF (
        NOT ISBLANK ( [Advances Mix B27] ),
        CALCULATE ( [Portfolio Cmp], Fact_Portfolio[Portfolio] = "Advances", Fact_Portfolio[Metric] = "Absolute" )
    )
MEASURE _Measures[Mover Impact] =
    VAR _n = SELECTEDVALUE ( Dim_Line[LineNo] )
    VAR _s =
        SWITCH ( TRUE (), _n IN { 2, 3, 5, 6, 10, 11, 12, 13, 14, 26 }, 1, _n IN { 18, 19 }, -1, 0 )
    VAR _d = _s * ( [Budget 2027] - [Compare Value] )
    RETURN IF ( _s <> 0 && ABS ( _d ) > 0.0001, _d )
MEASURE _Measures[Mover Colour] =
    IF ( [Mover Impact] >= 0, "#067647", "#B42318" )
MEASURE _Measures[Seg Income B27] =
    IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1, CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 16, Dim_Period[PeriodKey] = "B2027" ) )
MEASURE _Measures[Seg Income Cmp] =
    VAR _k = [Compare Key]
    RETURN IF ( SELECTEDVALUE ( Dim_Unit[Level], 9 ) <= 1, CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 16, Dim_Period[PeriodKey] = _k ) )
MEASURE _Measures[Seg Income Var %] =
    VAR _b = [Seg Income B27]
    VAR _c = [Seg Income Cmp]
    RETURN IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), DIVIDE ( _b - _c, ABS ( _c ) ) )
MEASURE _Measures[Seg Income Heat] =
    VAR _p = [Seg Income Var %]
    VAR _good = ( _p > 0 ) = ( 1 = 1 )
    VAR _a = ABS ( _p )
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( _p ) || _p = 0, "#F1F3F7",
            _good && _a >= 0.25, "#8FCFAE",
            _good && _a >= 0.08, "#C4E6D3",
            _good, "#E6F4EC",
            _a >= 0.25, "#EFA39A",
            _a >= 0.08, "#F6CCC6",
            "#FBE7E4"
        )
