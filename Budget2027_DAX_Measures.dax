        [Selected Unit Code]
    VAR _note =
        CALCULATE ( MAX ( Fact_Commentary[Note] ), Fact_Commentary[UnitCode] = _uc, Fact_Commentary[LineNo] = 31 )
    RETURN
        "<details class='fc'><summary><div class='in'><div class='face front' style='border-top-color:"
        & _col
        & "'><div class='kl'>Gross Advances<span class='ki'>i</span></div><div class='kv'>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & "<span class='ku'>"
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</span></div><div class='kd'><span class='pill' style='color:"
        & _col
        & ";background:"
        & _bg
        & "'>"
        & _arr
        & " "
        & IF ( ISBLANK ( _p ), "n/a", FORMAT ( _p, "+0.0%;-0.0%;0.0%" ) )
        & "</span><span class='kc'>vs "
        & [Compare Short]
        & "</span></div><svg class='sp' viewBox='0 0 120 30' preserveAspectRatio='none'><polyline class='sa' points='"
        & [Spark A Advances]
        & "' style='stroke:"
        & _col
        & "'/><polyline class='sf' points='"
        & [Spark F Advances]
        & "' style='stroke:"
        & _col
        & "'/></svg><div class='pg sep'><span>Sep-26 balance</span><b>"
        & IF ( ISBLANK ( _ytd ), "–", FORMAT ( _ytd, "#,0.0" ) )
        & "</b></div></div><div class='face back'><div class='bt'>Gross Advances</div><ul><li><b>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & " "
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</b>, "
        & IF ( _d >= 0, "up ", "down " )
        & IF ( ISBLANK ( _p ), "", FORMAT ( ABS ( _p ), "0.0%" ) )
        & " ("
        & IF ( ISBLANK ( _d ), "–", FORMAT ( _d, "+#,0.0;-#,0.0;0.0" ) )
        & ") vs "
        & [Compare Short]
        & ".</li><li>Advances to deposits <b>"
        & IF ( ISBLANK ( [ADR B27] ), "–", FORMAT ( [ADR B27], "0.0%" ) )
        & "</b>, was "
        & IF ( ISBLANK ( [ADR Cmp] ), "–", FORMAT ( [ADR Cmp], "0.0%" ) )
        & ".</li><li>Sep-26 "
        & IF ( ISBLANK ( _ytd ), "–", FORMAT ( _ytd, "#,0.0" ) )
        & ", Budget 2026 "
        & IF ( ISBLANK ( _b26 ), "–", FORMAT ( _b26, "#,0.0" ) )
        & ".</li></ul>"
        & IF ( ISBLANK ( _note ), "<div class='note empty'>Notes: Commentary sheet</div>", "<div class='note'>" & _note & "</div>" )
        & "</div></div></summary></details>"
MEASURE _Measures[HTML Card Deposits] =
    VAR _b =
        [Deposits B27]
    VAR _c =
        [Deposits Cmp]
    VAR _d =
        IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), _b - _c )
    VAR _p =
        DIVIDE ( _d, ABS ( _c ) )
    VAR _col =
        [Deposits Colour]
    VAR _bg =
        SWITCH ( _col, "#067647", "#E7F6EE", "#B42318", "#FDECEA", "#F1F3F7" )
    VAR _arr =
        IF ( _d > 0, "▲", IF ( _d < 0, "▼", "" ) )
    VAR _ytd =
        CALCULATE ( [YTD Sep-26], Dim_Line[LineNo] = 33 )
    VAR _b26 =
        CALCULATE ( [Budget 2026], Dim_Line[LineNo] = 33 )
    VAR _p26 =
        CALCULATE ( [Projected Dec-26], Dim_Line[LineNo] = 33 )
    VAR _prog =
        IF ( _b26 > 0, DIVIDE ( _ytd, _b26 ) )
    VAR _uc =
        [Selected Unit Code]
    VAR _note =
        CALCULATE ( MAX ( Fact_Commentary[Note] ), Fact_Commentary[UnitCode] = _uc, Fact_Commentary[LineNo] = 33 )
    RETURN
        "<details class='fc'><summary><div class='in'><div class='face front' style='border-top-color:"
        & _col
        & "'><div class='kl'>Deposits<span class='ki'>i</span></div><div class='kv'>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & "<span class='ku'>"
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</span></div><div class='kd'><span class='pill' style='color:"
        & _col
        & ";background:"
        & _bg
        & "'>"
        & _arr
        & " "
        & IF ( ISBLANK ( _p ), "n/a", FORMAT ( _p, "+0.0%;-0.0%;0.0%" ) )
        & "</span><span class='kc'>vs "
        & [Compare Short]
        & "</span></div><svg class='sp' viewBox='0 0 120 30' preserveAspectRatio='none'><polyline class='sa' points='"
        & [Spark A Deposits]
        & "' style='stroke:"
        & _col
        & "'/><polyline class='sf' points='"
        & [Spark F Deposits]
        & "' style='stroke:"
        & _col
        & "'/></svg><div class='pg sep'><span>Sep-26 balance</span><b>"
        & IF ( ISBLANK ( _ytd ), "–", FORMAT ( _ytd, "#,0.0" ) )
        & "</b></div></div><div class='face back'><div class='bt'>Deposits</div><ul><li><b>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & " "
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</b>, "
        & IF ( _d >= 0, "up ", "down " )
        & IF ( ISBLANK ( _p ), "", FORMAT ( ABS ( _p ), "0.0%" ) )
        & " ("
        & IF ( ISBLANK ( _d ), "–", FORMAT ( _d, "+#,0.0;-#,0.0;0.0" ) )
        & ") vs "
        & [Compare Short]
        & ".</li><li>Zero-cost current share <b>"
        & IF ( ISBLANK ( [Current Deposits Share B27] ), "–", FORMAT ( [Current Deposits Share B27], "0.0%" ) )
        & "</b>.</li><li>Sep-26 "
        & IF ( ISBLANK ( _ytd ), "–", FORMAT ( _ytd, "#,0.0" ) )
        & ", Budget 2026 "
        & IF ( ISBLANK ( _b26 ), "–", FORMAT ( _b26, "#,0.0" ) )
        & ".</li></ul>"
        & IF ( ISBLANK ( _note ), "<div class='note empty'>Notes: Commentary sheet</div>", "<div class='note'>" & _note & "</div>" )
        & "</div></div></summary></details>"
