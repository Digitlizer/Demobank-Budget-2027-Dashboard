        & "<span class='ku'>"
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</span></div><div class='kd'><span class='pill' style='color:"
        & _col
        & ";background:"
        & _bg
        & "'>"
        & _arr
        & " "
        & IF ( ISBLANK ( _p ), "n/a", FORMAT ( _p, "+0.0%;-0.0%;0.0%" ) )
        & "</span><span class='kc'>vs "
        & [Compare Short]
        & "</span></div><svg class='sp' viewBox='0 0 120 30' preserveAspectRatio='none'><polyline class='sa' points='"
        & [Spark A Borrowings]
        & "' style='stroke:"
        & _col
        & "'/><polyline class='sf' points='"
        & [Spark F Borrowings]
        & "' style='stroke:"
        & _col
        & "'/></svg><div class='pg sep'><span>Sep-26 balance</span><b>"
        & IF ( ISBLANK ( _ytd ), "–", FORMAT ( _ytd, "#,0.0" ) )
        & "</b></div></div><div class='face back'><div class='bt'>Borrowings</div><ul><li><b>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & " "
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</b>, "
        & IF ( _d >= 0, "up ", "down " )
        & IF ( ISBLANK ( _p ), "", FORMAT ( ABS ( _p ), "0.0%" ) )
        & " ("
        & IF ( ISBLANK ( _d ), "–", FORMAT ( _d, "+#,0.0;-#,0.0;0.0" ) )
        & ") vs "
        & [Compare Short]
        & ".</li><li>Sep-26 "
        & IF ( ISBLANK ( _ytd ), "–", FORMAT ( _ytd, "#,0.0" ) )
        & ", Budget 2026 "
        & IF ( ISBLANK ( _b26 ), "–", FORMAT ( _b26, "#,0.0" ) )
        & ".</li></ul>"
        & IF ( ISBLANK ( _note ), "<div class='note empty'>Notes: Commentary sheet</div>", "<div class='note'>" & _note & "</div>" )
        & "</div></div></summary></details>"
MEASURE _Measures[HTML KPI Strip] =
    "<div class='kpis'>" & [HTML Card PBT] & [HTML Card Total Income] & [HTML Card NII] & [HTML Card Admin Exp] & [HTML Card Advances] & [HTML Card Deposits] & "</div>"
MEASURE _Measures[HTML KPI Strip BS] =
    "<div class='kpis k4'>" & [HTML Card Advances] & [HTML Card Deposits] & [HTML Card Investments] & [HTML Card Borrowings] & "</div>"
MEASURE _Measures[HTML Nav Item] =
    VAR _u =
        SELECTEDVALUE ( 'Unit Selector'[UnitCode] )
    VAR _lv =
        SELECTEDVALUE ( 'Unit Selector'[Level] )
    VAR _k =
        [Compare Key]
    VAR _b =
        CALCULATE ( [Amount (Axis)], Dim_Unit[UnitCode] = _u, Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2027" )
    VAR _c =
        CALCULATE ( [Amount (Axis)], Dim_Unit[UnitCode] = _u, Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = _k )
    VAR _bank =
        CALCULATE ( [Amount (Axis)], Dim_Unit[UnitCode] = "BANK", Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2027" )
    VAR _sh =
        MIN ( 1, MAX ( 0, DIVIDE ( _b, _bank ) ) )
    VAR _up =
        _b >= _c
    RETURN
        IF ( _lv <= 1,
        "<div class='nv lv"
        & _lv
        & "'><div class='nt'><b>"
        & SELECTEDVALUE ( 'Unit Selector'[Unit] )
        & "</b><span class='nvv'>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & "<i style='color:"
        & IF ( _up, "#2FB37E", "#E5675C" )
        & "'>"
        & IF ( ISBLANK ( _c ) || ISBLANK ( _b ), "", IF ( _up, "▲", "▼" ) )
        & "</i></span></div><div class='nn'>"
        & SELECTEDVALUE ( 'Unit Selector'[UnitName] )
        & "</div><div class='nb'><span style='width:"
        & FORMAT ( _sh * 100, "0" )
        & "%'></span></div></div>"
        )
MEASURE _Measures[HTML Headline] =
    VAR _b =
        [PBT B27]
    VAR _c =
        [PBT Cmp]
    VAR _p =
        IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), DIVIDE ( _b - _c, ABS ( _c ) ) )
    RETURN
        "<div class='hl'><div class='hk'><b>"
        & [Selected Unit Name]
        & "</b><span>Budget 2027 vs "
        & [Compare Label]
        & " · PKR "
        & IF ( [Divisor] = 1000, "Bn", "Mn" )
        & "</span></div><div class='hs'>Profit before tax <b>"
        & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) )
        & "</b> <span class='pill "
        & IF ( _b >= _c, "g", "r" )
        & "'>"
        & IF ( ISBLANK ( _p ), "n/a", IF ( _b >= _c, "▲ ", "▼ " ) & FORMAT ( _p, "+0.0%;-0.0%" ) )
        & "</span><em>|</em>Cost to income <b>"
        & IF ( ISBLANK ( [Cost to Income Cmp] ), "–", FORMAT ( [Cost to Income Cmp], "0.0%" ) )
        & " to "
        & IF ( ISBLANK ( [Cost to Income B27] ), "–", FORMAT ( [Cost to Income B27], "0.0%" ) )
        & "</b><em>|</em>Advances to deposits <b>"
        & IF ( ISBLANK ( [ADR B27] ), "–", FORMAT ( [ADR B27], "0.0%" ) )
        & "</b></div></div>"
MEASURE _Measures[HTML Rings] =
    "<div class='rings'><div class='rg'><svg viewBox='0 0 68 68'><circle cx='34' cy='34' r='26' class='rt'/><circle cx='34' cy='34' r='26' class='rv' stroke-dasharray='"
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Cost to Income B27], 1 ) ) ) * 163.36, "0.0" )
        & " 163.36' transform='rotate(-90 34 34)'/><line x1='34' y1='3' x2='34' y2='15' class='rk' transform='rotate("
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Cost to Income Cmp], 1 ) ) ) * 360, "0" )
        & " 34 34)'/><text x='34' y='38' class='rx'>"
        & IF ( ISBLANK ( [Cost to Income B27] ), "–", FORMAT ( [Cost to Income B27], "0%" ) )
        & "</text></svg><div class='rn'>Cost to income</div><div class='rd' style='color:"
        & IF ( ( [Cost to Income B27] - [Cost to Income Cmp] > 0 ) = ( -1 = 1 ), "#067647", "#B42318" )
        & "'>"
        & IF ( ISBLANK ( [Cost to Income Cmp] ) || ISBLANK ( [Cost to Income B27] ), "", IF ( [Cost to Income B27] >= [Cost to Income Cmp], "▲ ", "▼ " ) & FORMAT ( ( [Cost to Income B27] - [Cost to Income Cmp] ) * 100, "+0.0;-0.0" ) & " pp" )
        & "</div></div><div class='rg'><svg viewBox='0 0 68 68'><circle cx='34' cy='34' r='26' class='rt'/><circle cx='34' cy='34' r='26' class='rv' stroke-dasharray='"
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [NII Share B27], 1 ) ) ) * 163.36, "0.0" )
        & " 163.36' transform='rotate(-90 34 34)'/><line x1='34' y1='3' x2='34' y2='15' class='rk' transform='rotate("
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [NII Share Cmp], 1 ) ) ) * 360, "0" )
        & " 34 34)'/><text x='34' y='38' class='rx'>"
        & IF ( ISBLANK ( [NII Share B27] ), "–", FORMAT ( [NII Share B27], "0%" ) )
        & "</text></svg><div class='rn'>Net interest share</div><div class='rd' style='color:"
        & IF ( ( [NII Share B27] - [NII Share Cmp] > 0 ) = ( 1 = 1 ), "#067647", "#B42318" )
        & "'>"
        & IF ( ISBLANK ( [NII Share Cmp] ) || ISBLANK ( [NII Share B27] ), "", IF ( [NII Share B27] >= [NII Share Cmp], "▲ ", "▼ " ) & FORMAT ( ( [NII Share B27] - [NII Share Cmp] ) * 100, "+0.0;-0.0" ) & " pp" )
        & "</div></div><div class='rg'><svg viewBox='0 0 68 68'><circle cx='34' cy='34' r='26' class='rt'/><circle cx='34' cy='34' r='26' class='rv' stroke-dasharray='"
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Profit Margin B27], 1 ) ) ) * 163.36, "0.0" )
        & " 163.36' transform='rotate(-90 34 34)'/><line x1='34' y1='3' x2='34' y2='15' class='rk' transform='rotate("
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [Profit Margin Cmp], 1 ) ) ) * 360, "0" )
        & " 34 34)'/><text x='34' y='38' class='rx'>"
        & IF ( ISBLANK ( [Profit Margin B27] ), "–", FORMAT ( [Profit Margin B27], "0%" ) )
        & "</text></svg><div class='rn'>Profit margin</div><div class='rd' style='color:"
        & IF ( ( [Profit Margin B27] - [Profit Margin Cmp] > 0 ) = ( 1 = 1 ), "#067647", "#B42318" )
        & "'>"
        & IF ( ISBLANK ( [Profit Margin Cmp] ) || ISBLANK ( [Profit Margin B27] ), "", IF ( [Profit Margin B27] >= [Profit Margin Cmp], "▲ ", "▼ " ) & FORMAT ( ( [Profit Margin B27] - [Profit Margin Cmp] ) * 100, "+0.0;-0.0" ) & " pp" )
        & "</div></div><div class='rg'><svg viewBox='0 0 68 68'><circle cx='34' cy='34' r='26' class='rt'/><circle cx='34' cy='34' r='26' class='rv' stroke-dasharray='"
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [ADR B27], 1.5 ) ) ) * 163.36, "0.0" )
        & " 163.36' transform='rotate(-90 34 34)'/><line x1='34' y1='3' x2='34' y2='15' class='rk' transform='rotate("
        & FORMAT ( MIN ( 1, MAX ( 0, DIVIDE ( [ADR Cmp], 1.5 ) ) ) * 360, "0" )
        & " 34 34)'/><text x='34' y='38' class='rx'>"
        & IF ( ISBLANK ( [ADR B27] ), "–", FORMAT ( [ADR B27], "0%" ) )
        & "</text></svg><div class='rn'>Advances / deposits</div><div class='rd' style='color:"
        & "#6B7586"
        & "'>"
        & IF ( ISBLANK ( [ADR Cmp] ) || ISBLANK ( [ADR B27] ), "", IF ( [ADR B27] >= [ADR Cmp], "▲ ", "▼ " ) & FORMAT ( ( [ADR B27] - [ADR Cmp] ) * 100, "+0.0;-0.0" ) & " pp" )
        & "</div></div></div>"
MEASURE _Measures[HTML Heatmap] =
    VAR _k = [Compare Key]
    VAR _sel = [Selected Unit Code]
    RETURN
        "<table class='hm'><thead><tr><th>Unit</th><th>Income</th><th>NII</th><th>Non-int</th><th>Admin</th><th>PBT</th><th>Advances</th><th>Deposits</th></tr></thead><tbody>"
        & CONCATENATEX (
            FILTER ( ALL ( Dim_Unit ), Dim_Unit[Level] <= 1 ),
            "<tr class='" & IF ( Dim_Unit[UnitCode] = _sel, "sel", "" ) & "'><td>" & Dim_Unit[ShortName] & "</td>" & ( VAR _hb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 16, Dim_Period[PeriodKey] = "B2027" )
            VAR _hc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 16, Dim_Period[PeriodKey] = _k )
            VAR _hp = IF ( NOT ISBLANK ( _hb ) && NOT ISBLANK ( _hc ), DIVIDE ( _hb - _hc, ABS ( _hc ) ) )
            VAR _hg = ( _hp > 0 ) = ( 1 = 1 )
            VAR _cls = SWITCH ( TRUE (), ISBLANK ( _hp ) || _hp = 0, "h0", _hg && ABS ( _hp ) >= 0.25, "g3", _hg && ABS ( _hp ) >= 0.08, "g2", _hg, "g1", ABS ( _hp ) >= 0.25, "r3", ABS ( _hp ) >= 0.08, "r2", "r1" )
            RETURN "<td class='" & _cls & "' title='B27 " & FORMAT ( _hb, "#,0.0" ) & " | was " & FORMAT ( _hc, "#,0.0" ) & "'>"
                & IF ( ISBLANK ( _hp ), "–", IF ( _hp > 0, "▲ ", "▼ " ) & IF ( ABS ( _hp ) >= 10, ">999%", FORMAT ( ABS ( _hp ), "0.0%" ) ) ) & "</td>" ) & ( VAR _hb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 8, Dim_Period[PeriodKey] = "B2027" )
            VAR _hc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 8, Dim_Period[PeriodKey] = _k )
            VAR _hp = IF ( NOT ISBLANK ( _hb ) && NOT ISBLANK ( _hc ), DIVIDE ( _hb - _hc, ABS ( _hc ) ) )
            VAR _hg = ( _hp > 0 ) = ( 1 = 1 )
            VAR _cls = SWITCH ( TRUE (), ISBLANK ( _hp ) || _hp = 0, "h0", _hg && ABS ( _hp ) >= 0.25, "g3", _hg && ABS ( _hp ) >= 0.08, "g2", _hg, "g1", ABS ( _hp ) >= 0.25, "r3", ABS ( _hp ) >= 0.08, "r2", "r1" )
            RETURN "<td class='" & _cls & "' title='B27 " & FORMAT ( _hb, "#,0.0" ) & " | was " & FORMAT ( _hc, "#,0.0" ) & "'>"
                & IF ( ISBLANK ( _hp ), "–", IF ( _hp > 0, "▲ ", "▼ " ) & IF ( ABS ( _hp ) >= 10, ">999%", FORMAT ( ABS ( _hp ), "0.0%" ) ) ) & "</td>" ) & ( VAR _hb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 15, Dim_Period[PeriodKey] = "B2027" )
            VAR _hc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 15, Dim_Period[PeriodKey] = _k )
            VAR _hp = IF ( NOT ISBLANK ( _hb ) && NOT ISBLANK ( _hc ), DIVIDE ( _hb - _hc, ABS ( _hc ) ) )
            VAR _hg = ( _hp > 0 ) = ( 1 = 1 )
            VAR _cls = SWITCH ( TRUE (), ISBLANK ( _hp ) || _hp = 0, "h0", _hg && ABS ( _hp ) >= 0.25, "g3", _hg && ABS ( _hp ) >= 0.08, "g2", _hg, "g1", ABS ( _hp ) >= 0.25, "r3", ABS ( _hp ) >= 0.08, "r2", "r1" )
            RETURN "<td class='" & _cls & "' title='B27 " & FORMAT ( _hb, "#,0.0" ) & " | was " & FORMAT ( _hc, "#,0.0" ) & "'>"
                & IF ( ISBLANK ( _hp ), "–", IF ( _hp > 0, "▲ ", "▼ " ) & IF ( ABS ( _hp ) >= 10, ">999%", FORMAT ( ABS ( _hp ), "0.0%" ) ) ) & "</td>" ) & ( VAR _hb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 23, Dim_Period[PeriodKey] = "B2027" )
            VAR _hc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 23, Dim_Period[PeriodKey] = _k )
            VAR _hp = IF ( NOT ISBLANK ( _hb ) && NOT ISBLANK ( _hc ), DIVIDE ( _hb - _hc, ABS ( _hc ) ) )
            VAR _hg = ( _hp > 0 ) = ( 0 = 1 )
            VAR _cls = SWITCH ( TRUE (), ISBLANK ( _hp ) || _hp = 0, "h0", _hg && ABS ( _hp ) >= 0.25, "g3", _hg && ABS ( _hp ) >= 0.08, "g2", _hg, "g1", ABS ( _hp ) >= 0.25, "r3", ABS ( _hp ) >= 0.08, "r2", "r1" )
            RETURN "<td class='" & _cls & "' title='B27 " & FORMAT ( _hb, "#,0.0" ) & " | was " & FORMAT ( _hc, "#,0.0" ) & "'>"
                & IF ( ISBLANK ( _hp ), "–", IF ( _hp > 0, "▲ ", "▼ " ) & IF ( ABS ( _hp ) >= 10, ">999%", FORMAT ( ABS ( _hp ), "0.0%" ) ) ) & "</td>" ) & ( VAR _hb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2027" )
            VAR _hc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = _k )
            VAR _hp = IF ( NOT ISBLANK ( _hb ) && NOT ISBLANK ( _hc ), DIVIDE ( _hb - _hc, ABS ( _hc ) ) )
            VAR _hg = ( _hp > 0 ) = ( 1 = 1 )
            VAR _cls = SWITCH ( TRUE (), ISBLANK ( _hp ) || _hp = 0, "h0", _hg && ABS ( _hp ) >= 0.25, "g3", _hg && ABS ( _hp ) >= 0.08, "g2", _hg, "g1", ABS ( _hp ) >= 0.25, "r3", ABS ( _hp ) >= 0.08, "r2", "r1" )
            RETURN "<td class='" & _cls & "' title='B27 " & FORMAT ( _hb, "#,0.0" ) & " | was " & FORMAT ( _hc, "#,0.0" ) & "'>"
                & IF ( ISBLANK ( _hp ), "–", IF ( _hp > 0, "▲ ", "▼ " ) & IF ( ABS ( _hp ) >= 10, ">999%", FORMAT ( ABS ( _hp ), "0.0%" ) ) ) & "</td>" ) & ( VAR _hb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 31, Dim_Period[PeriodKey] = "B2027" )
            VAR _hc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 31, Dim_Period[PeriodKey] = _k )
            VAR _hp = IF ( NOT ISBLANK ( _hb ) && NOT ISBLANK ( _hc ), DIVIDE ( _hb - _hc, ABS ( _hc ) ) )
            VAR _hg = ( _hp > 0 ) = ( 1 = 1 )
            VAR _cls = SWITCH ( TRUE (), ISBLANK ( _hp ) || _hp = 0, "h0", _hg && ABS ( _hp ) >= 0.25, "g3", _hg && ABS ( _hp ) >= 0.08, "g2", _hg, "g1", ABS ( _hp ) >= 0.25, "r3", ABS ( _hp ) >= 0.08, "r2", "r1" )
            RETURN "<td class='" & _cls & "' title='B27 " & FORMAT ( _hb, "#,0.0" ) & " | was " & FORMAT ( _hc, "#,0.0" ) & "'>"
                & IF ( ISBLANK ( _hp ), "–", IF ( _hp > 0, "▲ ", "▼ " ) & IF ( ABS ( _hp ) >= 10, ">999%", FORMAT ( ABS ( _hp ), "0.0%" ) ) ) & "</td>" ) & ( VAR _hb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 33, Dim_Period[PeriodKey] = "B2027" )
            VAR _hc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 33, Dim_Period[PeriodKey] = _k )
            VAR _hp = IF ( NOT ISBLANK ( _hb ) && NOT ISBLANK ( _hc ), DIVIDE ( _hb - _hc, ABS ( _hc ) ) )
            VAR _hg = ( _hp > 0 ) = ( 1 = 1 )
            VAR _cls = SWITCH ( TRUE (), ISBLANK ( _hp ) || _hp = 0, "h0", _hg && ABS ( _hp ) >= 0.25, "g3", _hg && ABS ( _hp ) >= 0.08, "g2", _hg, "g1", ABS ( _hp ) >= 0.25, "r3", ABS ( _hp ) >= 0.08, "r2", "r1" )
            RETURN "<td class='" & _cls & "' title='B27 " & FORMAT ( _hb, "#,0.0" ) & " | was " & FORMAT ( _hc, "#,0.0" ) & "'>"
                & IF ( ISBLANK ( _hp ), "–", IF ( _hp > 0, "▲ ", "▼ " ) & IF ( ABS ( _hp ) >= 10, ">999%", FORMAT ( ABS ( _hp ), "0.0%" ) ) ) & "</td>" ) & "</tr>",
            "",
            Dim_Unit[SortOrder], ASC
        )
        & "</tbody></table><div class='hk2'><span class='r3'></span>Worse<span class='r1'></span><span class='g1'></span><span class='g3'></span>Better &nbsp;·&nbsp; darker = bigger change; expenses count as better when they fall</div>"
MEASURE _Measures[HTML PL Summary] =
    "<table class='pl'><thead><tr><th>PKR</th><th>Dec-25 A</th><th>Dec-26 P</th><th>2027 B</th><th>Var %</th></tr></thead><tbody>" & CONCATENATEX (
            FILTER ( ALL ( Dim_Line ), Dim_Line[LineNo] IN { 8, 15, 16, 23, 24, 26, 28, 30 } ),
            VAR _b = CALCULATE ( [Budget 2027] )
                VAR _c = CALCULATE ( [Compare Value] )
                VAR _p = IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), DIVIDE ( _b - _c, ABS ( _c ) ) )
                VAR _g = IF ( ISBLANK ( _p ) || _p = 0, 0, IF ( ( _p > 0 ) = ( Dim_Line[HigherIsBetter] = 1 ), 1, -1 ) )
                VAR _cls = IF ( Dim_Line[LineNo] IN { 8, 16, 28 }, "key", IF ( Dim_Line[Nature] = "Subtotal" || Dim_Line[Statement] = "Balance Sheet" && Dim_Line[IsKPI] = 1, "sub", "" ) )
                RETURN "<tr class='" & _cls & "'><td>" & Dim_Line[LineItem] & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Actual Dec-25] ) ), "–", FORMAT ( CALCULATE ( [Actual Dec-25] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Projected Dec-26] ) ), "–", FORMAT ( CALCULATE ( [Projected Dec-26] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Budget 2027] ) ), "–", FORMAT ( CALCULATE ( [Budget 2027] ), "#,0.0" ) ) & "</td>" & "<td class='" & IF ( _g = 0, "", IF ( _g = 1, "up", "dn" ) ) & "'>" & IF ( ISBLANK ( _p ), "", IF ( _p > 0, "▲ ", "▼ " ) & IF ( ABS ( _p ) >= 10, ">999%", FORMAT ( ABS ( _p ), "0.0%" ) ) ) & "</td>" & "</tr>",
            "", Dim_Line[SortOrder], ASC ) & "</tbody></table>"
MEASURE _Measures[HTML PL Full] =
    "<table class='pl full'><thead><tr><th>PKR</th><th>Dec-24 A</th><th>Dec-25 A</th><th>Sep-26 YTD</th><th>Dec-26 P</th><th>Budget 2026</th><th>Budget 2027</th><th>Var</th><th>Var %</th></tr></thead><tbody>" & CONCATENATEX (
            ADDCOLUMNS ( SUMMARIZE ( ALL ( Dim_Line ), Dim_Line[Section] ), "@o", CALCULATE ( MIN ( Dim_Line[SortOrder] ) ) ),
            VAR _sec = Dim_Line[Section]
            VAR _rows =
                CONCATENATEX (
                    FILTER ( ALL ( Dim_Line ), Dim_Line[Section] = _sec && ( NOT ISBLANK ( CALCULATE ( [Budget 2027] ) ) || NOT ISBLANK ( CALCULATE ( [Projected Dec-26] ) ) || NOT ISBLANK ( CALCULATE ( [Actual Dec-25] ) ) ) ),
                    VAR _b = CALCULATE ( [Budget 2027] )
                VAR _c = CALCULATE ( [Compare Value] )
                VAR _p = IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), DIVIDE ( _b - _c, ABS ( _c ) ) )
                VAR _g = IF ( ISBLANK ( _p ) || _p = 0, 0, IF ( ( _p > 0 ) = ( Dim_Line[HigherIsBetter] = 1 ), 1, -1 ) )
                VAR _cls = IF ( Dim_Line[LineNo] IN { 8, 16, 28 }, "key", IF ( Dim_Line[Nature] = "Subtotal" || Dim_Line[Statement] = "Balance Sheet" && Dim_Line[IsKPI] = 1, "sub", "" ) )
                RETURN "<tr class='" & _cls & "'><td>" & Dim_Line[LineItem] & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Actual Dec-24] ) ), "–", FORMAT ( CALCULATE ( [Actual Dec-24] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Actual Dec-25] ) ), "–", FORMAT ( CALCULATE ( [Actual Dec-25] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [YTD Sep-26] ) ), "–", FORMAT ( CALCULATE ( [YTD Sep-26] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Projected Dec-26] ) ), "–", FORMAT ( CALCULATE ( [Projected Dec-26] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Budget 2026] ) ), "–", FORMAT ( CALCULATE ( [Budget 2026] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( CALCULATE ( [Budget 2027] ) ), "–", FORMAT ( CALCULATE ( [Budget 2027] ), "#,0.0" ) ) & "</td>" & "<td>" & IF ( ISBLANK ( IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), _b - _c ) ), "–", FORMAT ( IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _c ), _b - _c ), "+#,0.0;-#,0.0;0.0" ) ) & "</td>" & "<td class='" & IF ( _g = 0, "", IF ( _g = 1, "up", "dn" ) ) & "'>" & IF ( ISBLANK ( _p ), "", IF ( _p > 0, "▲ ", "▼ " ) & IF ( ABS ( _p ) >= 10, ">999%", FORMAT ( ABS ( _p ), "0.0%" ) ) ) & "</td>" & "</tr>",
                    "", Dim_Line[SortOrder], ASC )
            RETURN IF ( _rows = "", "", "<tr class='sec'><td colspan='9'>" & _sec & "</td></tr>" & _rows ),
            "", [@o], ASC ) & "</tbody></table>"
MEASURE _Measures[HTML Scorecard] =
    VAR _k = [Compare Key]
    VAR _bankPBT = CALCULATE ( [Amount (Axis)], Dim_Unit[UnitCode] = "BANK", Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2027" )
    RETURN
        "<table class='sc'><thead><tr><th>Segment</th><th>Income</th><th>NII</th><th>Admin</th><th>PBT</th><th>Advances</th><th>Deposits</th><th>Cost / income</th><th>Share of PBT</th></tr></thead><tbody>"
        & CONCATENATEX (
            FILTER ( ALL ( Dim_Unit ), Dim_Unit[Level] <= 1 ),
            "<tr class='" & IF ( Dim_Unit[Level] = 0, "tot", "" ) & "'><td><b>" & Dim_Unit[ShortName] & "</b><small>" & Dim_Unit[UnitName] & "</small></td>" & ( VAR _sb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 16, Dim_Period[PeriodKey] = "B2027" )
                VAR _sc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 16, Dim_Period[PeriodKey] = _k )
                VAR _sp = IF ( NOT ISBLANK ( _sb ) && NOT ISBLANK ( _sc ), DIVIDE ( _sb - _sc, ABS ( _sc ) ) )
                RETURN "<td>" & IF ( ISBLANK ( _sb ), "–", FORMAT ( _sb, "#,0.0" ) ) & IF ( ISBLANK ( _sp ), "", "<span class='chip " & IF ( ( _sp > 0 ) = ( 1 = 1 ), "up", "dn" ) & "'>" & IF ( _sp > 0, "▲ ", "▼ " ) & IF ( ABS ( _sp ) >= 10, ">999%", FORMAT ( ABS ( _sp ), "0.0%" ) ) & "</span>" ) & "</td>" ) & ( VAR _sb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 8, Dim_Period[PeriodKey] = "B2027" )
                VAR _sc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 8, Dim_Period[PeriodKey] = _k )
                VAR _sp = IF ( NOT ISBLANK ( _sb ) && NOT ISBLANK ( _sc ), DIVIDE ( _sb - _sc, ABS ( _sc ) ) )
                RETURN "<td>" & IF ( ISBLANK ( _sb ), "–", FORMAT ( _sb, "#,0.0" ) ) & "</td>" ) & ( VAR _sb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 23, Dim_Period[PeriodKey] = "B2027" )
                VAR _sc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 23, Dim_Period[PeriodKey] = _k )
                VAR _sp = IF ( NOT ISBLANK ( _sb ) && NOT ISBLANK ( _sc ), DIVIDE ( _sb - _sc, ABS ( _sc ) ) )
                RETURN "<td>" & IF ( ISBLANK ( _sb ), "–", FORMAT ( _sb, "#,0.0" ) ) & IF ( ISBLANK ( _sp ), "", "<span class='chip " & IF ( ( _sp > 0 ) = ( 0 = 1 ), "up", "dn" ) & "'>" & IF ( _sp > 0, "▲ ", "▼ " ) & IF ( ABS ( _sp ) >= 10, ">999%", FORMAT ( ABS ( _sp ), "0.0%" ) ) & "</span>" ) & "</td>" ) & ( VAR _sb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2027" )
                VAR _sc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = _k )
                VAR _sp = IF ( NOT ISBLANK ( _sb ) && NOT ISBLANK ( _sc ), DIVIDE ( _sb - _sc, ABS ( _sc ) ) )
                RETURN "<td>" & IF ( ISBLANK ( _sb ), "–", FORMAT ( _sb, "#,0.0" ) ) & IF ( ISBLANK ( _sp ), "", "<span class='chip " & IF ( ( _sp > 0 ) = ( 1 = 1 ), "up", "dn" ) & "'>" & IF ( _sp > 0, "▲ ", "▼ " ) & IF ( ABS ( _sp ) >= 10, ">999%", FORMAT ( ABS ( _sp ), "0.0%" ) ) & "</span>" ) & "</td>" ) & ( VAR _sb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 31, Dim_Period[PeriodKey] = "B2027" )
                VAR _sc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 31, Dim_Period[PeriodKey] = _k )
                VAR _sp = IF ( NOT ISBLANK ( _sb ) && NOT ISBLANK ( _sc ), DIVIDE ( _sb - _sc, ABS ( _sc ) ) )
                RETURN "<td>" & IF ( ISBLANK ( _sb ), "–", FORMAT ( _sb, "#,0.0" ) ) & IF ( ISBLANK ( _sp ), "", "<span class='chip " & IF ( ( _sp > 0 ) = ( 1 = 1 ), "up", "dn" ) & "'>" & IF ( _sp > 0, "▲ ", "▼ " ) & IF ( ABS ( _sp ) >= 10, ">999%", FORMAT ( ABS ( _sp ), "0.0%" ) ) & "</span>" ) & "</td>" ) & ( VAR _sb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 33, Dim_Period[PeriodKey] = "B2027" )
                VAR _sc = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 33, Dim_Period[PeriodKey] = _k )
                VAR _sp = IF ( NOT ISBLANK ( _sb ) && NOT ISBLANK ( _sc ), DIVIDE ( _sb - _sc, ABS ( _sc ) ) )
                RETURN "<td>" & IF ( ISBLANK ( _sb ), "–", FORMAT ( _sb, "#,0.0" ) ) & IF ( ISBLANK ( _sp ), "", "<span class='chip " & IF ( ( _sp > 0 ) = ( 1 = 1 ), "up", "dn" ) & "'>" & IF ( _sp > 0, "▲ ", "▼ " ) & IF ( ABS ( _sp ) >= 10, ">999%", FORMAT ( ABS ( _sp ), "0.0%" ) ) & "</span>" ) & "</td>" ) & ( VAR _i = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 16, Dim_Period[PeriodKey] = "B2027" )
                VAR _a = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 23, Dim_Period[PeriodKey] = "B2027" )
                VAR _pb = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2027" )
                RETURN "<td>" & IF ( _i > 0, FORMAT ( DIVIDE ( _a, _i ), "0.0%" ), "–" ) & "</td><td>" & FORMAT ( DIVIDE ( _pb, _bankPBT ), "0.0%" ) & "</td>" ) & "</tr>",
            "", Dim_Unit[Level], DESC, Dim_Unit[SortOrder], ASC )
        & "</tbody></table>"
MEASURE _Measures[HTML Tracker] =
    VAR _n = [Trk Line]
    VAR _hib = [Trk HIB]
    RETURN
        "<table class='tk'><thead><tr><th>Unit</th><th>Budget 2026</th><th>YTD Sep-26</th><th>Proj Dec-26</th><th class='l'>YTD progress (75% = on pace)</th><th>Proj / budget</th><th>Q4 needed</th><th>Avg quarter</th><th class='l'>Status</th></tr></thead><tbody>"
        & CONCATENATEX (
            FILTER ( ALL ( Dim_Unit ), Dim_Unit[Level] <= 1 ),
            VAR _b = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = _n, Dim_Period[PeriodKey] = "B2026" )
            VAR _y = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = _n, Dim_Period[PeriodKey] = "A2026S" )
            VAR _p = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = _n, Dim_Period[PeriodKey] = "P2026" )
            VAR _pr = IF ( _b > 0, DIVIDE ( _y, _b ) )
            VAR _r = DIVIDE ( _p, _b )
            VAR _st =
                SWITCH ( TRUE (),
                    ISBLANK ( _b ) || ISBLANK ( _p ), "n|·|No budget",
                    _hib = 0, IF ( _p <= _b * 1.005, "g|✓|Within budget", IF ( _p <= _b * 1.05, "a|!|Watch", "r|✕|Over budget" ) ),
                    _b <= 0, IF ( _p >= _b, "g|✓|Better than budget", "r|✕|Worse than budget" ),
                    _r >= 0.995, "g|✓|On track", _r >= 0.9, "a|!|Watch", "r|✕|Behind" )
            RETURN
                "<tr class='" & IF ( Dim_Unit[Level] = 0, "tot", "" ) & "'><td><b>" & Dim_Unit[ShortName] & "</b></td><td>" & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) ) & "</td><td>" & IF ( ISBLANK ( _y ), "–", FORMAT ( _y, "#,0.0" ) ) & "</td><td>" & IF ( ISBLANK ( _p ), "–", FORMAT ( _p, "#,0.0" ) ) & "</td>"
                & "<td class='l'>" & IF ( ISBLANK ( _pr ), "", "<div class='pb2'><span style='width:" & FORMAT ( MIN ( 1, MAX ( 0, _pr ) ) * 100, "0" ) & "%'></span><i></i></div>" ) & "</td>"
                & "<td>" & IF ( _b > 0, FORMAT ( _r, "0%" ), "–" ) & "</td><td>" & IF ( ISBLANK ( _b - _y ), "–", FORMAT ( _b - _y, "#,0.0" ) ) & "</td><td>" & IF ( ISBLANK ( DIVIDE ( _y, 3 ) ), "–", FORMAT ( DIVIDE ( _y, 3 ), "#,0.0" ) ) & "</td>"
                & "<td class='l'><span class='st " & PATHITEM ( _st, 1 ) & "'>" & PATHITEM ( _st, 2 ) & " " & PATHITEM ( _st, 3 ) & "</span></td></tr>",
            "", Dim_Unit[SortOrder], ASC )
        & "</tbody></table>"
MEASURE _Measures[HTML Landing] =
    "<div class='ld'>" & CONCATENATEX (
            FILTER ( ALL ( Dim_Unit ), Dim_Unit[Level] <= 1 ),
            VAR _b = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "B2026" )
            VAR _p = CALCULATE ( [Amount (Axis)], Dim_Line[LineNo] = 28, Dim_Period[PeriodKey] = "P2026" )
            VAR _r = DIVIDE ( _p, _b )
            VAR _c = SWITCH ( TRUE (), _r >= 0.995, "#2457A6", _r >= 0.9, "#38B2C8", "#B42318" )
            RETURN
                "<div class='lr'><b>" & Dim_Unit[ShortName] & "</b>"
                & IF ( _b > 0,
                    "<div class='lt'><span style='width:" & FORMAT ( MIN ( 1, MAX ( 0, _r / 1.5 ) ) * 100, "0" ) & "%;background:" & _c & "'></span><i></i></div><em>" & FORMAT ( _r, "0%" ) & "</em>",
                    "<div class='lx'>Loss unit: bud " & IF ( ISBLANK ( _b ), "–", FORMAT ( _b, "#,0.0" ) ) & ", proj " & IF ( ISBLANK ( _p ), "–", FORMAT ( _p, "#,0.0" ) ) & IF ( _p >= _b, " ✓", " ✕" ) & "</div>" )
                & "</div>",
            "", Dim_Unit[SortOrder], ASC )
        & "<div class='lf'>Projected Dec-26 PBT as % of Budget 2026. Line = 100%.</div></div>"
MEASURE _Measures[HTML Income Mix] =
    VAR _t0 =
        FILTER ( ADDCOLUMNS ( ALL ( 'Income Mix' ), "@lab", 'Income Mix'[Component], "@v", VAR _ln = 'Income Mix'[LineNo] RETURN CALCULATE ( [Budget 2027], Dim_Line[LineNo] = _ln ), "@o", 'Income Mix'[Sort] ), [@v] > 0 )
    VAR _t =
        ADDCOLUMNS ( _t0, "@i", VAR _o = [@o] RETURN COUNTROWS ( FILTER ( _t0, [@o] <= _o ) ) )
    VAR _tot = SUMX ( _t, [@v] )
    VAR _rows =
        ADDCOLUMNS ( _t,
            "@cum", VAR _i = [@i] RETURN SUMX ( FILTER ( _t, [@i] < _i ), [@v] ),
            "@c", SWITCH ( [@i], 1, "#2457A6", 2, "#B87A00", 3, "#E87BA4", 4, "#00875A", 5, "#6250D6", "#A3ABB8" ) )
    VAR _arcs =
        CONCATENATEX ( _rows,
            "<circle cx='60' cy='60' r='46' class='ds' style='stroke:" & [@c] & "' stroke-dasharray='"
                & FORMAT ( MAX ( 0, [@v] / _tot * 289.03 - 1.5 ), "0.00" ) & " 289.03' stroke-dashoffset='"
                & FORMAT ( - [@cum] / _tot * 289.03, "0.00" ) & "' transform='rotate(-90 60 60)'/>",
            "", [@i], ASC )
    VAR _leg =
        CONCATENATEX ( _rows,
            "<div class='dr'><i style='background:" & [@c] & "'></i><span>" & [@lab] & "</span><b>" & FORMAT ( [@v], "#,0.0" )
                & "</b><em>" & FORMAT ( DIVIDE ( [@v], _tot ), "0%" ) & "</em></div>",
            "", [@i], ASC )
    RETURN
        IF ( _tot > 0,
            "<div class='dn'><svg viewBox='0 0 120 120' class='dsv'><circle cx='60' cy='60' r='46' class='dbg'/>" & _arcs
            & "<text x='60' y='59' class='dt'>" & FORMAT ( [Total Income B27], "#,0.0" ) & "</text><text x='60' y='72' class='dl'>Total income</text></svg>"
            & "<div class='dlg'><div class='dh'><span>Component</span><b>" & IF ( [Divisor] = 1000, "PKR Bn", "PKR Mn" ) & "</b><em>Share</em></div>" & _leg & "</div></div>",
            "<div class='dn empty'>Mix not available for this unit</div>" )
MEASURE _Measures[HTML Deposit Mix] =
    VAR _g =
        GROUPBY (
            ADDCOLUMNS (
                FILTER ( ALL ( Dim_Product ), Dim_Product[Portfolio] = "Deposits" && Dim_Product[RowType] = "Product" ),
                "@grp", IF ( Dim_Product[Product] IN { "Current", "Saving", "Notice Deposits", "Term Deposits", "FCY Deposits" }, SUBSTITUTE ( Dim_Product[Product], " Deposits", "" ), "Other" ),
                "@ord", SWITCH ( Dim_Product[Product], "Current", 1, "Saving", 2, "Notice Deposits", 3, "Term Deposits", 4, "FCY Deposits", 5, 9 ),
                "@val", CALCULATE ( [Portfolio B27], Fact_Portfolio[Metric] = "Absolute" )
            ),
            [@grp],
            "@gv", SUMX ( CURRENTGROUP (), [@val] ),
            "@go", MINX ( CURRENTGROUP (), [@ord] )
        )
    VAR _t0 =
        FILTER ( ADDCOLUMNS ( _g, "@lab", [@grp], "@v", [@gv], "@o", [@go] ), [@v] > 0 )
    VAR _t =
        ADDCOLUMNS ( _t0, "@i", VAR _o = [@o] RETURN COUNTROWS ( FILTER ( _t0, [@o] <= _o ) ) )
    VAR _tot = SUMX ( _t, [@v] )
    VAR _rows =
        ADDCOLUMNS ( _t,
            "@cum", VAR _i = [@i] RETURN SUMX ( FILTER ( _t, [@i] < _i ), [@v] ),
            "@c", SWITCH ( [@i], 1, "#2457A6", 2, "#B87A00", 3, "#E87BA4", 4, "#00875A", 5, "#6250D6", "#A3ABB8" ) )
    VAR _arcs =
        CONCATENATEX ( _rows,
            "<circle cx='60' cy='60' r='46' class='ds' style='stroke:" & [@c] & "' stroke-dasharray='"
                & FORMAT ( MAX ( 0, [@v] / _tot * 289.03 - 1.5 ), "0.00" ) & " 289.03' stroke-dashoffset='"
                & FORMAT ( - [@cum] / _tot * 289.03, "0.00" ) & "' transform='rotate(-90 60 60)'/>",
            "", [@i], ASC )
    VAR _leg =
        CONCATENATEX ( _rows,
            "<div class='dr'><i style='background:" & [@c] & "'></i><span>" & [@lab] & "</span><b>" & FORMAT ( [@v], "#,0.0" )
                & "</b><em>" & FORMAT ( DIVIDE ( [@v], _tot ), "0%" ) & "</em></div>",
            "", [@i], ASC )
    RETURN
        IF ( _tot > 0,
            "<div class='dn'><svg viewBox='0 0 120 120' class='dsv'><circle cx='60' cy='60' r='46' class='dbg'/>" & _arcs
            & "<text x='60' y='59' class='dt'>" & FORMAT ( _tot, "#,0.0" ) & "</text><text x='60' y='72' class='dl'>Total deposits</text></svg>"
            & "<div class='dlg'><div class='dh'><span>Component</span><b>" & IF ( [Divisor] = 1000, "PKR Bn", "PKR Mn" ) & "</b><em>Share</em></div>" & _leg & "</div></div>",
            "<div class='dn empty'>Mix not available for this unit</div>" )

EVALUATE
SUMMARIZECOLUMNS ( Dim_Unit[ShortName], "PBT Budget 2027", [Seg PBT B27] )
